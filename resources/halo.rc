        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Halo Desktop\0"
            VALUE "FileDescription",  "Halo Desktop\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "HaloDesktop\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "LumnOverlay.exe\0"
            VALUE "ProductName",      "Halo Desktop\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

